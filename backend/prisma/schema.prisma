generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  tasks     Task[]
}

model Task {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  status          String        @default("Backlog")
  userId          String        @db.ObjectId
  workStatus      String        @default("Pending")
  
  // 🔽 ADD THIS LINE RIGHT HERE TO REGISTER THE ARRAY FIELD 🔽
  testCases       String[]      
  
  startDate       DateTime?
  endDate         DateTime?
  effortRequired  Int?
  deployedTime    DateTime?
  deploymentType  String?
  createdAt       DateTime      @default(now())
  
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeLogs        TimeLog[]
  history         TaskHistory[]
}

model TimeLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId 
  taskId      String   @db.ObjectId
  logDate     DateTime
  hoursSpent  Float
  description String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId 
  taskId    String   @db.ObjectId
  eventType String   
  details   String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
