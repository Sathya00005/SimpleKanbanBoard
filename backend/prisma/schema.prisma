generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  tasks     Task[]
}

model Task {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId

  name            String
  description     String?

  status          String

  startDate       DateTime?
  endDate         DateTime?

  effortRequired  Int?

  workStatus      String?

  createdAt       DateTime @default(now())

  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
}